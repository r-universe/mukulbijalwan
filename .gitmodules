[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "DPSynth"]
	path = DPSynth
	url = https://github.com/cran/DPSynth
[submodule "DPrivStats"]
	path = DPrivStats
	url = https://github.com/cran/DPrivStats
[submodule "IFFuzzyStats"]
	path = IFFuzzyStats
	url = https://github.com/cran/IFFuzzyStats
[submodule "fuzzySurvival"]
	path = fuzzySurvival
	url = https://github.com/mukulbijalwan/fuzzysurvival
[submodule "progme"]
	path = progme
	url = https://github.com/cran/progme
